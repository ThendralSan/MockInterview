# Node Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment Variables & Secrets (CRITICAL: Never commit API keys)
.env
*.env
backend/.env
!.env.example
!backend/.env.example

# Build Outputs
dist/
frontend/dist/
out-tsc/
bazel-out/
tmp/

# Angular Cache
.angular/
frontend/.angular/

# IDE / Editor configuration
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.suo
*.user
*.userosscache
*.sln.docstates

# OS Generated Files
.DS_Store
Thumbs.db
Desktop.ini
Desktop (create shortcut)

# Local Runtime Data & Uploads
backend/data/*
!backend/data/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
*.db
*.db-wal
*.db-shm

# Log Files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
